# Les valeurs commerciales et légales (marque, domaine public, société, délai de grâce,
# conservation, régime de mesure) sont des VALEURS PAR DÉFAUT : elles se modifient ensuite
# dans /admin/reglages. Les secrets restent ici.

# --- Application -------------------------------------------------------------
APP_URL=http://localhost:3000
NEXT_PUBLIC_BRAND_NAME=Carto            # nom provisoire, à remplacer
SUPPORT_EMAIL=support@example.invalid

# --- Base de données (PostgreSQL 16) ------------------------------------------
DATABASE_URL=postgres://cartes:cartes@localhost:5432/cartes_dev
DATABASE_POOL_MAX=10

# --- Authentification ---------------------------------------------------------
# Secret long et aléatoire (ex. `openssl rand -base64 48`). Ne jamais le committer.
BETTER_AUTH_SECRET=

# --- Emails -------------------------------------------------------------------
# log  : aucun envoi, consultation sur /dev/emails (développement)
# smtp : envoi réel via SMTP_URL
EMAIL_MODE=log
SMTP_URL=
EMAIL_FROM="Carto <no-reply@example.invalid>"

# --- Stockage des médias ------------------------------------------------------
STORAGE_DRIVER=local                    # local | s3
LOCAL_STORAGE_DIR=./storage
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# --- Paiement (Stripe) --------------------------------------------------------
# Sans clé : mode local, aucune souscription possible, aucun paiement simulé.
STRIPE_SECRET_KEY=                      # sk_test_… en test
STRIPE_WEBHOOK_SECRET=                  # whsec_…
STRIPE_ALLOW_LIVE=false                 # true requis pour accepter une clé sk_live_…
BILLING_GRACE_DAYS=7                    # proposition, à valider

# --- Statistiques ---------------------------------------------------------------
ANALYTICS_MODE=minimal                  # minimal | off
ANALYTICS_REQUIRE_CONSENT=false         # true : aucune mesure avant accord du visiteur
ANALYTICS_RAW_RETENTION_DAYS=395        # proposition, à valider

# --- Informations légales de l'exploitant (obligatoires avant production) -------
LEGAL_COMPANY_NAME=
LEGAL_FORM=
LEGAL_CAPITAL=
LEGAL_ADDRESS=
LEGAL_SIREN=
LEGAL_VAT=
LEGAL_DIRECTOR=
LEGAL_HOST=
LEGAL_CONTACT_EMAIL=

# --- Apple Wallet (facultatif ; boutons masqués si non configuré) --------------
# Certificat « Pass Type ID » du programme Apple Developer. PEM en clair (« \n » accepté)
# ou en base64 via les variantes *_B64.
APPLE_WALLET_PASS_TYPE_ID=
APPLE_WALLET_TEAM_ID=
APPLE_WALLET_SIGNER_CERT=
APPLE_WALLET_SIGNER_KEY=
APPLE_WALLET_SIGNER_KEY_PASSPHRASE=
APPLE_WALLET_WWDR=

# --- Google Wallet (facultatif ; boutons masqués si non configuré) -------------
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_WALLET_SERVICE_ACCOUNT_EMAIL=
GOOGLE_WALLET_PRIVATE_KEY=
GOOGLE_WALLET_CLASS_SUFFIX=carte-visite

# --- Sauvegardes (docs/SAUVEGARDE.md) --------------------------------------------
# Destination : s3 (recommandé en production, bucket DÉDIÉ chez un autre fournisseur ou
# dans une autre région), local (dossier BACKUP_DIR) ou off.
BACKUP_DRIVER=local
BACKUP_DIR=./backups
BACKUP_S3_BUCKET=
BACKUP_S3_REGION=                       # à défaut : S3_REGION
BACKUP_S3_ENDPOINT=                     # à défaut : S3_ENDPOINT
BACKUP_S3_ACCESS_KEY_ID=                # à défaut : S3_ACCESS_KEY_ID
BACKUP_S3_SECRET_ACCESS_KEY=            # à défaut : S3_SECRET_ACCESS_KEY
BACKUP_S3_FORCE_PATH_STYLE=false
# Clé de chiffrement AES-256 : `openssl rand -base64 32`. À conserver AUSSI hors du
# serveur (gestionnaire de mots de passe) : sans elle, les sauvegardes sont illisibles.
BACKUP_ENCRYPTION_KEY=
# Base vide dédiée aux essais de restauration automatiques (hebdomadaires). Jamais la
# base de production : son contenu est remplacé à chaque essai.
BACKUP_RESTORE_TEST_DATABASE_URL=
BACKUP_ALERT_EMAIL=                     # défaut : email d'assistance
PG_DUMP_PATH=                           # si pg_dump n'est pas dans le PATH
PG_RESTORE_PATH=
