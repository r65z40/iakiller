# Application web. Installation : voir docs/INSTALLATION.md, section « Production ».
# sudo cp deploy/systemd/carto.service /etc/systemd/system/ && sudo systemctl enable --now carto
[Unit]
Description=Cartes de visite numériques (Next.js)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=carto
Group=carto
WorkingDirectory=/opt/carto
EnvironmentFile=/opt/carto/.env
Environment=NODE_ENV=production
Environment=npm_config_cache=/opt/carto/.npm
Environment=PORT=3000
Environment=HOSTNAME=127.0.0.1
ExecStart=/usr/bin/npm start
Restart=always
RestartSec=5
# Durcissement
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/carto/storage /opt/carto/backups /opt/carto/.next /opt/carto/.npm

[Install]
WantedBy=multi-user.target
